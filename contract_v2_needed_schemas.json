    "anyOf": [
     {
      "type": "string",
      "enum": [
       "success",
       "failed"
      ]
     },
     {
      "type": "null"
     }
    ],
    "title": "Submit Result",
    "description": "提交结果回写（FR-24，契约 v2 修订）；未回写为 null"
   },
   "fail_reason": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Fail Reason",
    "description": "submit_result=failed 时的失败原因（D-06 结果视图 / FR-24）"
   },
   "submitted_at": {
    "anyOf": [
     {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 时间戳（UTC 存储）"
     },
     {
      "type": "null"
     }
    ],
    "title": "Submitted At",
    "description": "回写时间；未回写为 null"
   }
  },
  "type": "object",
  "required": [
   "confirmed_fields",
   "submit_token",
   "expires_at"
  ],
  "title": "ConfirmationConfirmed",
  "description": "已确认：submit_token 仅在此时出现（BR-1 唯一点）；token 过期/已消耗时为 null，走 UI「重新放行」恢复。"
 },
